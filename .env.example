# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# MediKiosk Full-Stack Environment Configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/medikiosk"
SUPABASE_DB_URL=""
REDIS_URL="redis://localhost:6379/0"
JWT_SECRET="medikiosk-super-secure-jwt-secret-key-2026"

# AWS S3 Document Storage
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET="medikiosk-records"
AWS_REGION="ap-south-1"

# AI / ML Services (Mistral & Bhashini / AI4Bharat)
MISTRAL_API_KEY=""
BHASHINI_API_KEY=""

# ABDM / ABHA Integration
ABHA_CLIENT_ID=""
ABHA_CLIENT_SECRET=""

# Endpoints & Mode Flags
FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:3000"
AI_MOCK_MODE=true
BHASHINI_MOCK_MODE=true
ABHA_MOCK_MODE=true
OCR_MOCK_MODE=false

